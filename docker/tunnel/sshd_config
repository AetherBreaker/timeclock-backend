# Forwarding-only sshd: each clock may open exactly its own remote port (permitlisten in
# authorized_keys) and nothing else. GatewayPorts lets that port listen on the container's
# interfaces, where Coolify reaches it over the coolify network as timeclock-tunnel:<port>.
Port 22
HostKey /etc/ssh/keys/ssh_host_ed25519_key
AuthorizedKeysFile /etc/ssh/tunnel_authorized_keys
AllowUsers tctunnel
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no

AllowTcpForwarding remote
GatewayPorts clientspecified
AllowAgentForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTTY no
PermitTunnel no
ForceCommand /bin/false

ClientAliveInterval 30
ClientAliveCountMax 3
LogLevel VERBOSE
